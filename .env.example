# ──────────────────────────────────────────────────────────────────────────────
# UnitWatt – Environment Variables
# Copy this file to .env and fill in the values you need.
# ──────────────────────────────────────────────────────────────────────────────

# ── Bill Reader Selection ─────────────────────────────────────────────────────
# Which reader to use: gemini | groq | openrouter | ollama | offline
# If unset, the first API with a key is used; otherwise offline.
# UNITWATT_READER=

# ── Google Gemini (free tier) ─────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=          # alternative name, same key

# ── Groq (free tier) ─────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=

# ── OpenRouter (free models) ──────────────────────────────────────────────────
# Get a free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# ── Ollama (local models) ────────────────────────────────────────────────────
# Only needed if Ollama runs on a different host/port (default: localhost:11434)
# OLLAMA_HOST=localhost:11434

# ── Advanced Overrides ────────────────────────────────────────────────────────
# Override the preset model, endpoint, or API key for any reader.
# UNITWATT_MODEL=
# UNITWATT_BASE_URL=
# UNITWATT_API_KEY=

# ── WhatsApp bot (Meta Cloud API) ─────────────────────────────────────────────
# From your Meta app: WhatsApp → API Setup (token, phone number ID) and App settings → Basic (secret).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v23.0

# ── Telegram bot ──────────────────────────────────────────────────────────────
# Create a bot with @BotFather, then run: python -m unitwatt.bot telegram
# TELEGRAM_BOT_TOKEN=

# ── People who may use the bot ───────────────────────────────────────────────
# phone:role:name[:language], comma-separated; roles: owner, supervisor, accountant, auditor.
# Real numbers belong here, not in the factory profile in the repo.
# UNITWATT_CONTACTS=919812345678:owner:Ramesh:hi,919812345679:supervisor:Sunil:hi

# ── Voice notes (speech to text) ─────────────────────────────────────────────
# Uses GROQ_API_KEY above (free Whisper) if set. Or: groq | local | none
# UNITWATT_STT=
# UNITWATT_STT_BASE_URL=        # any OpenAI-compatible /audio/transcriptions endpoint
# UNITWATT_STT_MODEL=
# UNITWATT_STT_API_KEY=

# ── API server ────────────────────────────────────────────────────────────────
# Turns on the REST API (send it as the X-API-Key header). Leave unset to keep it off.
# UNITWATT_API_TOKEN=
# UNITWATT_BOT_DB=data/unitwatt_bot.sqlite
